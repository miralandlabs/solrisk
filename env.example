# Required (same plain names as spl-balance / aethervane — per-Vercel-project isolation)
X402_FACILITATOR_URL=https://preview.ipay.sh/api/v1/facilitator
X402_PAY_TO=<YourSolriskVaultPDA>
X402_NETWORK=solana:EtWTRABZaYq6iMfeYKouRu166VU2xqa1
RPC_URL=https://devnet.helius-rpc.com/?api-key=<YOUR_HELIUS_KEY>

# Optional
X402_MERCHANT_WALLET=<YourSolriskSellerWallet>
X402_SCHEME=exact
X402_PAYMENT_AMOUNT_USDC=0.05
X402_PAYMENT_TIMEOUT_SECONDS=300

# Optional — DB (omit to run stateless like spl-balance)
# DATABASE_URL=postgresql://user:pass@host:5432/dbname?sslmode=require

# Solrisk tuning (env-only, not from DB)
# SOLRISK_PARAMETERS_CACHE_TTL_SEC=60
# SOLRISK_RPC_MAX_ATTEMPTS=3
# SOLRISK_RPC_INITIAL_BACKOFF_MS=120
# SOLRISK_RPC_TOTAL_BUDGET_MS=6000
